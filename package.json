{
  "name": "@repo/mono",
  "description": "Frontend monorepo boilerplate",
  "author": {
    "name": "Jonas Bröms",
    "email": "jonas.broms@gmail.com"
  },
  "repository": {
    "url": "https://github.com/bromso/kitchensink-react"
  },
  "keywords": [
    "boilerplate",
    "monorepo",
    "turborepo",
    "next.js"
  ],
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "next": "^16.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "@iconify/react": "^6.0.0",
    "zod": "^4.1.13",
    "@hookform/resolvers": "^5.2.2",
    "react-hook-form": "^7.68.0",
    "@serwist/next": "^9.2.3",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "lighthouse": "^12.0.0",
    "chrome-launcher": "^1.1.2",
    "cheerio": "^1.0.0",
    "robots-parser": "^3.0.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "scripts": {
    "build": "turbo build",
    "build:app": "turbo build --filter @repo/app",
    "build:www": "turbo build --filter @repo/www",
    "build:docs": "turbo build --filter @repo/docs",
    "build:legal": "turbo build --filter @repo/legal",
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter @repo/app",
    "dev:www": "turbo dev --filter @repo/www",
    "start": "turbo start",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "turbo lint",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "turbo check-types",
    "validate": "bun format && bun lint && bun check && bun run build",
    "ci": "biome ci . && turbo check-types && turbo build",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next",
    "doctor": "bun scripts/doctor.ts",
    "story": "bun --filter @repo/story dev",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset tag",
    "release": "bun run build && changeset publish",
    "prepare": "husky",
    "commit": "cz",
    "commitlint": "commitlint --edit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@repo/typescript-config": "workspace:*",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "msw": "^2.7.0",
    "sharp": "^0.34.5",
    "tsdown": "^0.6.7",
    "turbo": "^2.5.5",
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.1",
    "@hookform/resolvers": "^5.2.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^25.0.2",
    "country-region-data": "^4.0.0",
    "recharts": "^3.6.0"
  }
}
