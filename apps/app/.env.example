# Supabase
# Both vars are optional in dev: @repo/supabase falls back to the local
# Supabase CLI defaults when NODE_ENV !== "production" and these are
# unset. Run `supabase start` and you're good to go. Set them when
# pointing at a hosted Supabase (staging, prod-like).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://app.lvh.me:3001

# Auth (cross-app session + bounce target)
NEXT_PUBLIC_AUTH_URL=http://auth.lvh.me:3002
AUTH_COOKIE_DOMAIN=.lvh.me
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.lvh.me
