{
  "name": "@repo/app",
  "version": "1.1.0",
  "description": "Application shell — frontend boilerplate",
  "keywords": [
    "boilerplate",
    "next.js"
  ],
  "author": "Jonas Bröms",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001 --hostname app.localhost",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start --port 3001",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "validate": "bun format && bun lint && bun check && bun run build",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "catalog:",
    "@iconify/react": "catalog:",
    "@repo/ui": "workspace:*",
    "@serwist/next": "catalog:",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "1.0.4",
    "country-region-data": "^4.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "motion": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-day-picker": "^9.11.1",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "recharts": "^3.6.0",
    "tailwind-merge": "catalog:",
    "tailwindcss-animate": "catalog:",
    "vaul": "^1.1.2",
    "web-vitals": "^5.1.0",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "browserslist": [
    "Chrome >= 109",
    "Firefox >= 115",
    "Safari >= 16.4",
    "Edge >= 109",
    "not dead"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@next/bundle-analyzer": "^16.0.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.10",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fake-indexeddb": "^6.2.5",
    "graphql-config": "^5.1.5",
    "happy-dom": "^20.10.1",
    "postcss": "^8",
    "serwist": "^9.2.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
