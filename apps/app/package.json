  },
  "browserslist": [
    "Chrome >= 109",
    "Firefox >= 115",
    "Safari >= 16.4",
    "Edge >= 109",
    "not dead"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@next/bundle-analyzer": "^16.0.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^25.0.10",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "graphql-config": "^5.1.5",
    "postcss": "^8",
    "serwist": "^9.2.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
